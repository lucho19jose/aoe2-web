# Development Environment Configuration
# This file is safe for version control (no sensitive data)

# Django settings
SECRET_KEY=dev-secret-key-not-for-production-use-only-for-local-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL)
DB_NAME=aoe2_web
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis (Cache & Channels)
REDIS_HOST=redis
REDIS_PORT=6379

# CORS (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
