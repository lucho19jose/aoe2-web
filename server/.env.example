# ==========================================
# AoE2 Web Edition - Environment Variables
# ==========================================
#
# IMPORTANT: Never commit the actual .env file!
# Generate SECRET_KEY with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

# Django settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=aoe2_web
DB_USER=postgres
DB_PASSWORD=change-this-strong-password-in-production
DB_HOST=db
DB_PORT=5432

# Redis (Cache & Channels)
REDIS_HOST=redis
REDIS_PORT=6379

# CORS (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production settings (uncomment and configure for production)
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
