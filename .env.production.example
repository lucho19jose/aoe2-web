# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# IMPORTANT: Copy this file to .env.production and fill in the actual values
# Never commit .env.production to git!

# ========================================
# Django Settings
# ========================================
DJANGO_SETTINGS_MODULE=core.settings
SECRET_KEY=changeme-generate-a-secure-random-key-here-min-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ========================================
# Database Configuration
# ========================================
DB_NAME=aoe2_production
DB_USER=aoe2_user
DB_PASSWORD=changeme-strong-password
DB_HOST=db
DB_PORT=5432

# Backup database (optional for replication)
DB_BACKUP_ENABLED=True
DB_BACKUP_RETENTION_DAYS=30

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis-password
REDIS_DB=0
REDIS_CACHE_DB=1

# ========================================
# CORS & Security
# ========================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True

# ========================================
# Email Configuration (for notifications)
# ========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ========================================
# SSL/HTTPS Configuration
# ========================================
# Let's Encrypt email for SSL certificates
LETSENCRYPT_EMAIL=admin@yourdomain.com
DOMAIN=yourdomain.com

# ========================================
# Logging & Monitoring
# ========================================
LOG_LEVEL=INFO
ENABLE_SENTRY=True
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# Performance & Caching
# ========================================
CACHE_TIMEOUT=300
REDIS_CACHE_TIMEOUT=3600

# ========================================
# Celery Configuration
# ========================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ========================================
# Static & Media Files
# ========================================
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/mediafiles

# CDN Configuration (optional)
USE_CDN=False
CDN_URL=https://cdn.yourdomain.com

# ========================================
# Backup Configuration
# ========================================
BACKUP_STORAGE_TYPE=s3  # or 'local', 'gcs'
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_STORAGE_BUCKET_NAME=aoe2-backups
AWS_S3_REGION_NAME=us-east-1

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ========================================
# WebSocket Configuration
# ========================================
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_INTERVAL=30

# ========================================
# Application Settings
# ========================================
MAX_PLAYERS_PER_GAME=8
GAME_TICK_RATE=30
ENABLE_MATCHMAKING=True

# ========================================
# Third-party Services (optional)
# ========================================
# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Payment (if monetizing)
STRIPE_PUBLIC_KEY=pk_live_xxxx
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ========================================
# Development Override (keep False in production)
# ========================================
ENABLE_DEBUG_TOOLBAR=False
ENABLE_CORS_ALL_ORIGINS=False
